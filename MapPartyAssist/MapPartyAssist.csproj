<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/13.0.0">
  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <DalamudLibPath Condition="'$(DALAMUD_HOME)' == '' And Exists('$(MSBuildProjectDirectory)/../../CrescentCompass/.sdk/Dalamud.dll')">$(MSBuildProjectDirectory)/../../CrescentCompass/.sdk/</DalamudLibPath>
    <AssemblySearchPaths>$(DalamudLibPath);{CandidateAssemblyFiles};{HintPathFromItem};{TargetFrameworkDirectory};{RawFileName}</AssemblySearchPaths>
    <Authors>SaMo</Authors>
    <Company></Company>
    <Version>2.5.1.6</Version>
    <Description>Map Party Features.</Description>
    <Copyright></Copyright>
    <PackageProjectUrl></PackageProjectUrl>
  </PropertyGroup>

  <PropertyGroup>
	<PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)'))=./</PathMap>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="LiteDB" Version="5.0.16" />
  </ItemGroup>

  <Target Name="VerifyDalamudApi13" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DalamudLibPath)/Dalamud.dll')" Text="Set DALAMUD_HOME or DalamudLibPath to an API 13 SDK directory." />
    <GetAssemblyIdentity AssemblyFiles="$(DalamudLibPath)/Dalamud.dll">
      <Output TaskParameter="Assemblies" ItemName="DalamudIdentity" />
    </GetAssemblyIdentity>
    <Error Condition="$([MSBuild]::VersionLessThan('%(DalamudIdentity.Version)', '13.0')) Or $([MSBuild]::VersionGreaterThanOrEquals('%(DalamudIdentity.Version)', '14.0'))" Text="MapPartyAssist requires Dalamud API 13." />
  </Target>
</Project>
